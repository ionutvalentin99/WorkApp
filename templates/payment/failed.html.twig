{% extends 'base.html.twig' %}
{% block title %}Plată eșuată{% endblock %}
{% block body %}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="mb-4">
                <i class="bi bi-x-circle-fill text-danger" style="font-size: 4rem;"></i>
            </div>
            <h2 class="mb-2">Plata nu a fost finalizată</h2>
            <p class="text-muted mb-4">
                Compania <strong>{{ company.name }}</strong> a fost creată, dar plata nu a fost procesată.
                Poți reîncerca oricând din pagina companiei.
            </p>
            <div class="d-flex gap-2 justify-content-center">
                <a href="{{ path('app_stripe_checkout') }}" class="btn btn-primary">
                    Reîncearcă plata
                </a>
                <a href="{{ path('app_home') }}" class="btn btn-outline-secondary">
                    Acasă
                </a>
            </div>
        </div>
    </div>
</div>

{% endblock %}
