{% extends 'base.html.twig' %}

{% block title %}ePontaje | Adaugă pontaj{% endblock %}

{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block body %}
<div class="container py-4">
    <div class="row g-4">

        {# ── Formular ── #}
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <h5 class="fw-semibold mb-4">
                        <i class="bi bi-plus-circle me-2 text-primary"></i>Înregistrare nouă
                    </h5>
                    {{ form(form) }}
                </div>
            </div>
        </div>

        {# ── Pontaje azi ── #}
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <h5 class="fw-semibold mb-4">
                        <i class="bi bi-calendar-check me-2 text-primary"></i>Pontaje azi, {{ date }}
                    </h5>

                    {% if pontaje %}
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>De la</th>
                                        <th>Până la</th>
                                        <th>Ore lucrate</th>
                                        <th>Detalii</th>
                                    </tr>
                                </thead>
                                <tbody>
                                {% for pontaj in pontaje %}
                                    <tr>
                                        <td>{{ pontaj.timeStart|date("H:i") }}</td>
                                        <td>{{ pontaj.timeEnd|date("H:i") }}</td>
                                        <td>
                                            {% set diff = date(pontaj.timeEnd).diff(date(pontaj.timeStart)) %}
                                            {% if diff|date("%d") %}
                                                {{ diff|date("%d") }}z {{ diff|date("%h") }}h {{ diff|date("%i") }}m
                                            {% elseif not diff|date("%h") %}
                                                {{ diff|date("%i") }} minute
                                            {% elseif not diff|date("%i") %}
                                                {{ diff|date("%h") }} ore
                                            {% else %}
                                                {{ diff|date("%h") }}h {{ diff|date("%i") }}m
                                            {% endif %}
                                        </td>
                                        <td class="text-muted">{{ pontaj.details }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <p class="text-muted mb-0">Nu ai niciun pontaj înregistrat astăzi.</p>
                    {% endif %}
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}
