{% extends 'base.html.twig' %}

{% form_theme form 'bootstrap_5_layout.html.twig' %}
{% form_theme formMonth 'bootstrap_5_layout.html.twig' %}

{% block title %}ePontaje | Înregistrări{% endblock %}

{% block body %}
<div class="container py-4">

    {# ── Navigare ── #}
    {% set route = app.request.attributes.get('_route') %}
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a href="{{ path('app_pontaj_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            <span class="d-none d-sm-inline ms-1">Adaugă pontaj</span>
        </a>
        <a href="{{ path('app_pontaj') }}" class="btn {{ route == 'app_pontaj' ? 'btn-primary' : 'btn-outline-primary' }}">
            <i class="bi bi-house"></i>
            <span class="d-none d-sm-inline ms-1">Active</span>
        </a>
        <a href="{{ path('app_pontaj_your_records') }}" class="btn {{ route == 'app_pontaj_your_records' ? 'btn-primary' : 'btn-outline-primary' }}">
            <i class="bi bi-person-lines-fill"></i>
            <span class="d-none d-sm-inline ms-1">Pontajele mele</span>
        </a>
        <a href="{{ path('app_pontaj_company_records') }}" class="btn {{ route == 'app_pontaj_company_records' ? 'btn-primary' : 'btn-outline-primary' }}">
            <i class="bi bi-people"></i>
            <span class="d-none d-sm-inline ms-1">Toți angajații</span>
        </a>
    </div>

    {# ── Filtre ── #}
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-5">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3">
                    <p class="text-muted small mb-2 fw-medium">
                        <i class="bi bi-calendar-day me-1"></i>Caută după zi
                    </p>
                    {{ form_start(form, {'attr': {'class': 'd-flex align-items-end gap-2'}}) }}
                        <div class="flex-grow-1">
                            {{ form_label(form.date, null, {'label_attr': {'class': 'form-label small mb-1'}}) }}
                            {{ form_widget(form.date) }}
                        </div>
                        {{ form_widget(form.save) }}
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
        <div class="col-12 col-md-7">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3">
                    <p class="text-muted small mb-2 fw-medium">
                        <i class="bi bi-calendar-range me-1"></i>Caută pe interval
                    </p>
                    {{ form_start(formMonth, {'attr': {'class': 'd-flex align-items-end gap-2 flex-wrap'}}) }}
                        <div class="flex-grow-1">
                            {{ form_label(formMonth.dateFrom, null, {'label_attr': {'class': 'form-label small mb-1'}}) }}
                            {{ form_widget(formMonth.dateFrom) }}
                        </div>
                        <div class="flex-grow-1">
                            {{ form_label(formMonth.dateTo, null, {'label_attr': {'class': 'form-label small mb-1'}}) }}
                            {{ form_widget(formMonth.dateTo) }}
                            {% if formMonth.dateTo.vars.errors|length %}
                                <div class="text-danger small mt-1">
                                    {{ form_errors(formMonth.dateTo) }}
                                </div>
                            {% endif %}
                        </div>
                        {{ form_widget(formMonth.save) }}
                    {{ form_end(formMonth) }}
                </div>
            </div>
        </div>
    </div>

    {# ── Tabel înregistrări ── #}
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-3 p-md-4">

            {% if pontaje %}
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="fw-semibold mb-0">
                        <i class="bi bi-list-ul me-2 text-primary"></i>Înregistrări
                    </h5>
                    <span class="badge bg-primary rounded-pill">{{ entryNumber }} înregistrări</span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Angajat</th>
                                <th class="d-none d-md-table-cell">Zi</th>
                                <th>De la</th>
                                <th>Până la</th>
                                <th class="d-none d-md-table-cell">Ore lucrate</th>
                                <th class="d-none d-lg-table-cell">Detalii</th>
                                <th class="d-none d-lg-table-cell">Companie</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for pontaj in pagination %}
                            <tr>
                                <td class="text-nowrap fw-medium">
                                    {{ pontaj.user.firstName }} {{ pontaj.user.lastName }}
                                </td>
                                <td class="d-none d-md-table-cell text-nowrap text-muted">
                                    {{ pontaj.timeStart|date("D, d.M.Y") }}
                                </td>
                                <td class="text-nowrap">{{ pontaj.timeStart|date("H:i") }}</td>
                                <td class="text-nowrap">{{ pontaj.timeEnd|date("H:i") }}</td>
                                <td class="d-none d-md-table-cell text-nowrap">
                                    {% set diff = date(pontaj.timeEnd).diff(date(pontaj.timeStart)) %}
                                    {% if diff|date("%d") %}
                                        {{ diff|date("%d") }}z {{ diff|date("%h") }}h {{ diff|date("%i") }}m
                                    {% elseif not diff|date("%h") %}
                                        {{ diff|date("%i") }} min
                                    {% elseif not diff|date("%i") %}
                                        {{ diff|date("%h") }}h
                                    {% else %}
                                        {{ diff|date("%h") }}h {{ diff|date("%i") }}m
                                    {% endif %}
                                </td>
                                <td class="d-none d-lg-table-cell text-muted">{{ pontaj.details }}</td>
                                <td class="d-none d-lg-table-cell">{{ pontaj.company.name }}</td>
                                <td class="text-end text-nowrap">
                                    {% if app.user == pontaj.user %}
                                        <a href="{{ path('app_pontaj_update', {id: pontaj.id}) }}"
                                           class="btn btn-sm btn-outline-primary me-1"
                                           title="Editează">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="{{ path('app_pontaj_delete', {id: pontaj.id}) }}"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Șterge"
                                           onclick="return confirm('Ești sigur că vrei să ștergi?')">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    {% else %}
                                        <span class="text-muted small">—</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div class="mt-3 d-flex justify-content-center">
                    {{ knp_pagination_render(pagination) }}
                </div>

            {% else %}
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-muted" style="font-size: 2.5rem;"></i>
                    <p class="text-muted mt-3 mb-0">Nu există înregistrări pentru perioada selectată.</p>
                </div>
            {% endif %}

        </div>
    </div>

</div>
{% endblock %}
