{% extends 'base.html.twig' %}

{% block title %}ePontaje | Istoricul concediilor{% endblock %}

{% block body %}
<div class="container py-4">

    {% set route = app.request.attributes.get('_route') %}
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a href="{{ path('app_concediu_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            <span class="d-none d-sm-inline ms-1">Cerere nouă</span>
        </a>
        <a href="{{ path('app_concediu') }}" class="btn {{ route == 'app_concediu' ? 'btn-primary' : 'btn-outline-primary' }}">
            <i class="bi bi-house"></i>
            <span class="d-none d-sm-inline ms-1">Acasă</span>
        </a>
        <a href="{{ path('app_concediu_showconcedii') }}" class="btn {{ route == 'app_concediu_showconcedii' ? 'btn-primary' : 'btn-outline-primary' }}">
            <i class="bi bi-clock-history"></i>
            <span class="d-none d-sm-inline ms-1">Istoricul meu</span>
        </a>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_pending_concedii') }}" class="btn btn-outline-secondary">
                <i class="bi bi-shield-check"></i>
                <span class="d-none d-sm-inline ms-1">Aprobare cereri</span>
            </a>
        {% endif %}
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-3 p-md-4">
            <h5 class="fw-semibold mb-4">
                <i class="bi bi-clock-history me-2 text-primary"></i>Istoricul cererilor tale
            </h5>

            {% if concedii %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>De la</th>
                                <th>Până la</th>
                                <th>Status</th>
                                <th class="d-none d-md-table-cell">Detalii</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for concediu in pagination %}
                            <tr>
                                <td class="text-nowrap">{{ concediu.startDate|date("d.M.Y") }}</td>
                                <td class="text-nowrap">{{ concediu.endDate|date("d.M.Y") }}</td>
                                <td>
                                    {% if concediu.status == 'pending' %}
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-hourglass-split me-1"></i>În așteptare
                                        </span>
                                    {% elseif concediu.status == 'approved' %}
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i>Aprobat
                                        </span>
                                    {% elseif concediu.status == 'denied' %}
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle me-1"></i>Respins
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="d-none d-md-table-cell text-muted small">
                                    {% if concediu.status == 'approved' %}
                                        Aprobat la {{ concediu.approvedAt|date('d.M.Y H:i') }}
                                    {% elseif concediu.status == 'denied' %}
                                        <span class="text-danger">{{ concediu.details }}</span>
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div class="mt-3 d-flex justify-content-center">
                    {{ knp_pagination_render(pagination) }}
                </div>
            {% else %}
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-muted" style="font-size: 2.5rem;"></i>
                    <p class="text-muted mt-3 mb-3">Nu ai nicio cerere de concediu trimisă.</p>
                    <a href="{{ path('app_concediu_new') }}" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i>Trimite prima cerere
                    </a>
                </div>
            {% endif %}
        </div>
    </div>

</div>
{% endblock %}
