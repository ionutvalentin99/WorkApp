{% extends 'base.html.twig' %}

{% block title %}ePontaje | Concedii{% endblock %}

{% block body %}
<div class="container py-4">

    {% set route = app.request.attributes.get('_route') %}
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a href="{{ path('app_concediu_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            <span class="d-none d-sm-inline ms-1">Cerere nouă</span>
        </a>
        <a href="{{ path('app_concediu') }}" class="btn {{ route == 'app_concediu' ? 'btn-primary' : 'btn-outline-primary' }}">
            <i class="bi bi-house"></i>
            <span class="d-none d-sm-inline ms-1">Acasă</span>
        </a>
        <a href="{{ path('app_concediu_showconcedii') }}" class="btn {{ route == 'app_concediu_showconcedii' ? 'btn-primary' : 'btn-outline-primary' }}">
            <i class="bi bi-clock-history"></i>
            <span class="d-none d-sm-inline ms-1">Istoricul meu</span>
        </a>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_pending_concedii') }}" class="btn {{ route == 'app_pending_concedii' ? 'btn-primary' : 'btn-outline-secondary' }}">
                <i class="bi bi-shield-check"></i>
                <span class="d-none d-sm-inline ms-1">Aprobare cereri</span>
            </a>
        {% endif %}
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4 p-md-5 text-center">
            <i class="bi bi-umbrella text-primary" style="font-size: 3rem;"></i>
            <h4 class="fw-semibold mt-3 mb-2">Gestionare concedii</h4>
            <p class="text-muted mb-4">Trimite o cerere de concediu sau vizualizează istoricul cererilor tale.</p>
            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a href="{{ path('app_concediu_new') }}" class="btn btn-primary px-4">
                    <i class="bi bi-plus-lg me-1"></i>Cerere nouă
                </a>
                <a href="{{ path('app_concediu_showconcedii') }}" class="btn btn-outline-primary px-4">
                    <i class="bi bi-clock-history me-1"></i>Istoricul meu
                </a>
            </div>
        </div>
    </div>

</div>
{% endblock %}
