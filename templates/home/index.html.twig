{% extends 'base.html.twig' %}

{% block title %}ePontaje | Dashboard{% endblock %}

{% block body %}
    {% if app.user %}
        {# ================= SECTION: LOGGED IN USER ================= #}
        {% set totalMinutes = 0 %}
        {% set countRecords = 0 %}
        {% if pontaje is defined %}
            {% for p in pontaje %}
                {% set diff = date(p.timeEnd).diff(date(p.timeStart)) %}
                {% set totalMinutes = totalMinutes + (diff.h * 60) + diff.i %}
                {% set countRecords = countRecords + 1 %}
            {% endfor %}
        {% endif %}
        {% set totalHours = (totalMinutes / 60)|round(1, 'floor') %}

        <div class="text-white pb-5 pt-4 shadow-lg" style="background: linear-gradient(135deg, var(--bs-primary) 0%, var(--bs-secondary) 100%);">
            <div class="container pb-4">
                <div class="d-flex justify-content-between align-items-end flex-wrap gap-3">
                    <div>
                        {% set hour = "now"|date("H") %}
                        <span class="badge bg-white bg-opacity-25 text-white mb-2 fw-normal">
                            <i class="bi bi-calendar-event me-1"></i> {{ "now"|date("l, d F Y") }}
                        </span>
                        <h1 class="fw-bold display-5 mb-1">
                            {% if hour < 12 %}Bună dimineața,{% elseif hour < 18 %}Bună ziua,{% else %}Bună seara,{% endif %}
                            {{ app.user.firstName }}!
                        </h1>
                        <p class="lead text-white text-opacity-75 mb-0">Iată activitatea ta de astăzi.</p>
                    </div>

                    {% set _activeCompany = active_company() %}
                    {% if _activeCompany %}
                        <div class="bg-white bg-opacity-10 rounded-3 p-3 d-flex align-items-center border border-white border-opacity-25">
                            <div class="d-flex align-items-center justify-content-center bg-white text-primary rounded-3 p-2 me-3" style="width: 48px; height: 48px;">
                                <i class="bi bi-building fs-4"></i>
                            </div>
                            <div>
                                <small class="d-block text-uppercase text-white text-opacity-75" style="font-size: 0.75rem;">Companie</small>
                                <span class="fw-bold fs-5">{{ _activeCompany.name }}</span>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    {% else %}
        {# ================= SECTION: GUEST HERO ================= #}
        <div class="text-white py-5 py-lg-6 shadow-lg" style="background: linear-gradient(135deg, var(--bs-primary) 0%, var(--bs-secondary) 100%);">
            <div class="container py-4">
                <div class="row align-items-center">
                    <div class="col-lg-7 text-center text-lg-start">
                        {# Folosim clase responsive pentru text: fs-1 pe mobil, display-4 pe mediu #}
                        <h1 class="fs-1 display-md-4 fw-bold mb-3">Gestionează timpul echipei tale cu <span class="text-info">ePontaje</span>.</h1>

                        {# Textul descriptiv ajustat la o dimensiune mai potrivita pe mobil #}
                        <p class="lead mb-4 mb-lg-5 text-white-50 fs-5 fs-lg-4">Simplitate, eficiență și rapoarte precise. Tot ce ai nevoie pentru pontajul angajaților într-o singură aplicație modernă.</p>

                        {# BUTOANELE: d-grid pe mobil le face block (una sub alta), d-sm-flex le pune inline de la sm în sus #}
                        <div class="d-grid d-sm-flex justify-content-center justify-content-lg-start gap-3">
                            {# Am redus padding-ul orizontal pentru mobil (px-4) și am lăsat dimensiunea standard (am scos btn-lg de pe mobil pt a evita deformarea) #}
                            <a href="{{ path('app_registration') }}" class="btn btn-light btn-lg px-4 px-md-5 fw-bold shadow">Înregistrare</a>
                            <a href="{{ path('app_login') }}" class="btn btn-outline-light btn-lg px-4 px-md-5">Autentificare</a>
                        </div>
                    </div>

                    {# Iconita mare vizibila doar pe ecrane mari #}
                    <div class="col-lg-5 d-none d-lg-block text-center mt-5 mt-lg-0">
                        <i class="bi bi-clock-history" style="font-size: 15rem; opacity: 0.2;"></i>
                    </div>
                </div>
            </div>
        </div>

        {# Quick Features for Guests #}
        {# Am eliminat mt-n5 care cauza suprapuneri ciudate. Acum se curge natural. #}
        <div class="container py-5">
            <div class="row g-4 text-center">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                        <i class="bi bi-lightning-fill text-primary display-5 mb-3"></i>
                        <h4 class="fw-bold">Rapid</h4>
                        <p class="text-muted mb-0">Înregistrează orele de lucru cu doar câteva click-uri de pe orice dispozitiv.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                        <i class="bi bi-shield-check text-primary display-5 mb-3"></i>
                        <h4 class="fw-bold">Sigur</h4>
                        <p class="text-muted mb-0">Datele tale sunt în siguranță și accesibile doar membrilor autorizați din companie.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                        <i class="bi bi-graph-up-arrow text-primary display-5 mb-3"></i>
                        <h4 class="fw-bold">Rapoarte</h4>
                        <p class="text-muted mb-0">Exportă rapoarte detaliate pentru procesarea salarială în câteva secunde.</p>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# ================= MAIN CONTENT CONTAINER ================= #}
    <div class="container" style="margin-top: -3rem;">

        {# ================= ALERTS ================= #}
        {% if app.request.query.get('error') %}
            <div class="alert alert-danger shadow-sm border-0 rounded-3 mb-4 d-flex align-items-center">
                <i class="bi bi-exclamation-octagon-fill fs-4 me-3"></i>
                <div>
                    <strong>Error encountered:</strong> {{ app.request.query.get('error') }}
                </div>
            </div>
        {% endif %}

        {# ================= NO COMPANY STATE ================= #}
        {% if app.user and not active_company() %}
            <div class="card border-0 shadow rounded-4 mb-4 text-center">
                <div class="card-body p-5">
                    <div class="mb-4">
                        {# Am inlocuit culoarea inline cu text-primary pentru o integrare perfecta in tema #}
                        <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle p-4 text-primary">
                            <i class="bi bi-buildings display-6"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold text-dark">Nu ești încă într-o companie</h3>
                    <p class="text-muted mb-4 mx-auto w-50">
                        Pentru a începe pontajul, trebuie să te alături unei echipe existente sau să creezi propria ta companie.
                    </p>
                    {# Am pus btn-primary in loc de style="background-color:..." #}
                    <div class="d-flex justify-content-center gap-3">
                        <a href="{{ path('app_company_new') }}" class="btn btn-primary btn-lg rounded-pill px-4 text-white shadow-sm">
                            <i class="bi bi-building-add me-2"></i> Creează o Companie
                        </a>
                        <a href="{{ path('app_company_search') }}" class="btn btn-outline-primary btn-lg rounded-pill px-4 shadow-sm">
                            <i class="bi bi-search me-2"></i> Caută o Companie
                        </a>
                    </div>
                </div>
            </div>
        {% endif %}

        {# ================= DASHBOARD GRID ================= #}
        {% if app.user and active_company() %}
            <div class="row g-4 mb-4">

                {# --- CARD 1: PONTAJ RAPID --- #}
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex align-items-center mb-3">
                                <div class="d-inline-flex align-items-center justify-content-center text-white rounded-3 p-3 me-3 bg-primary">
                                    <i class="bi bi-clock-fill fs-5"></i>
                                </div>
                                <h5 class="fw-bold mb-0">Pontaj Rapid</h5>
                            </div>
                            <p class="text-muted small">Începe o sesiune de lucru sau adaugă ore manual.</p>
                            <div class="d-grid mt-auto">
                                <a href="{{ path('app_pontaj_new') }}" class="btn btn-primary rounded-pill text-white">
                                    <i class="bi bi-play-circle me-2"></i> Adaugă Pontaj
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                {# --- CARD 2: TOTAL ORE --- #}
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="d-inline-flex align-items-center justify-content-center bg-secondary text-white rounded-3 p-3 me-3">
                                        <i class="bi bi-bar-chart-fill fs-5"></i>
                                    </div>
                                    <h5 class="fw-bold mb-0">Total Ore</h5>
                                </div>
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-primary active" id="btnStatWeek" onclick="showStat('week')">Săpt.</button>
                                    <button type="button" class="btn btn-outline-primary" id="btnStatMonth" onclick="showStat('month')">Lună</button>
                                </div>
                            </div>
                            <div id="statWeek" class="mt-auto">
                                <h2 class="fw-bold mb-0">{{ weekTotals.hours }}<small class="fs-6 text-muted fw-normal">h</small></h2>
                                <span class="text-muted small">din {{ weekTotals.count }} intrări &bull; {{ weekTotals.label }}</span>
                            </div>
                            <div id="statMonth" class="mt-auto d-none">
                                <h2 class="fw-bold mb-0">{{ monthTotals.hours }}<small class="fs-6 text-muted fw-normal">h</small></h2>
                                <span class="text-muted small">din {{ monthTotals.count }} intrări &bull; {{ monthTotals.label }}</span>
                            </div>
                        </div>
                    </div>
                </div>

                {# --- CARD 3: QR PONTAJ --- #}
                {% set _qrCompany = active_company() %}
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4 d-flex flex-column">
                            {% if not _qrCompany %}
                                <div class="d-flex align-items-center mb-2">
                                    <div class="d-inline-flex align-items-center justify-content-center bg-light text-muted rounded-3 p-3 me-3">
                                        <i class="bi bi-building-x fs-5"></i>
                                    </div>
                                    <h5 class="fw-bold mb-0 text-muted">Pontaj QR</h5>
                                </div>
                                <p class="text-muted small mb-3">Nu ești înregistrat în nicio companie. Alătură-te sau creează una pentru a folosi pontajul QR.</p>
                                <a href="{{ path('app_company_search') }}" class="btn btn-sm btn-outline-primary rounded-pill mt-auto">Caută companie</a>
                            {% elseif not _qrCompany.isPaid() %}
                                <div class="d-flex align-items-center mb-2">
                                    <div class="d-inline-flex align-items-center justify-content-center bg-light text-muted rounded-3 p-3 me-3">
                                        <i class="bi bi-lock fs-5"></i>
                                    </div>
                                    <h5 class="fw-bold mb-0 text-muted">Pontaj QR</h5>
                                </div>
                                {% if app.user == _qrCompany.owner %}
                                    <p class="text-muted small mb-3">Compania nu este activată. Finalizează plata pentru a putea înregistra pontaje.</p>
                                    <a href="{{ path('app_company') }}" class="btn btn-sm btn-outline-primary rounded-pill mt-auto">Activează compania</a>
                                {% else %}
                                    <p class="text-muted small mb-0">Compania nu este activată. Contactează administratorul companiei.</p>
                                {% endif %}
                            {% elseif openPontaj %}
                                <div class="row g-0 align-items-center h-100">
                                    <div class="col-12 col-md-6 pe-md-3 mb-3 mb-md-0">
                                        <div class="d-inline-flex align-items-center justify-content-center bg-warning text-white rounded-3 p-2 mb-2">
                                            <i class="bi bi-qr-code-scan fs-5"></i>
                                        </div>
                                        <h5 class="fw-bold mb-1 text-warning">Pontaj deschis</h5>
                                        <p class="text-muted small mb-0">
                                            Start: <strong>{{ openPontaj.timeStart|date('H:i') }}</strong><br>
                                            Scanează pentru a termina
                                        </p>
                                    </div>
                                    <div class="col-12 col-md-6 d-flex justify-content-center justify-content-md-end">
                                        <div id="qrCanvas" class="rounded-2" style="line-height:0;"></div>
                                    </div>
                                </div>
                            {% else %}
                                <div class="row g-0 align-items-center h-100">
                                    <div class="col-12 col-md-6 pe-md-3 mb-3 mb-md-0">
                                        <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-3 p-2 mb-2">
                                            <i class="bi bi-qr-code fs-5"></i>
                                        </div>
                                        <h5 class="fw-bold mb-1">Pontaj QR</h5>
                                        <p class="text-muted small mb-0">Scanează pentru a deschide un pontaj</p>
                                    </div>
                                    <div class="col-12 col-md-6 d-flex justify-content-center justify-content-md-end">
                                        <div id="qrCanvas" class="rounded-2" style="line-height:0;"></div>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            {# ================= RECENT RECORDS TABLE ================= #}
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white p-4 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Pontaje Recente</h5>
                    <span class="badge bg-light text-dark border rounded-pill px-3">Ultimele intrări</span>
                </div>

                {% if pontaje is defined and pontaje|length > 0 %}
                    {# --- VARIANTĂ DESKTOP: Tabel (vizibil doar de la md în sus) --- #}
                    <div class="table-responsive d-none d-md-block">
                        <table class="table align-middle mb-0 table-hover">
                            <thead class="bg-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-4 py-3 border-0">Data</th>
                                <th class="py-3 border-0">Interval</th>
                                <th class="py-3 border-0">Durată</th>
                                <th class="py-3 border-0">Detalii</th>
                                <th class="text-end pe-4 py-3 border-0">Acțiuni</th>
                            </tr>
                            </thead>
                            <tbody class="border-top-0">
                            {% for pontaj in pontaje %}
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center">
                                            {# Eliminat inline style, folosit text-primary #}
                                            <div class="d-flex align-items-center justify-content-center bg-light text-primary rounded-circle me-3" style="width: 40px; height: 40px;">
                                                <span class="fw-bold small">{{ pontaj.timeStart|date('d') }}</span>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">{{ pontaj.timeStart|date('F') }}</div>
                                                <div class="small text-muted">{{ pontaj.timeStart|date('l') }}</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3">
                                        <span class="badge bg-light text-dark border fw-normal">{{ pontaj.timeStart|date('H:i') }}</span>
                                        <i class="bi bi-arrow-right text-muted mx-1 small"></i>
                                        {% if pontaj.timeEnd %}
                                            <span class="badge bg-light text-dark border fw-normal">{{ pontaj.timeEnd|date('H:i') }}</span>
                                        {% else %}
                                            <span class="badge bg-warning text-dark fw-normal">în curs</span>
                                        {% endif %}
                                    </td>
                                    <td class="py-3">
                                        {% if pontaj.timeEnd %}
                                            {% set diff = date(pontaj.timeEnd).diff(date(pontaj.timeStart)) %}
                                            <span class="fw-bold text-primary">{{ diff|date('%h') }}h {{ diff|date('%i') }}m</span>
                                        {% else %}
                                            <span class="text-warning fw-bold">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="py-3 text-muted small">{{ pontaj.details|default('—') }}</td>
                                    <td class="text-end pe-4 py-3">
                                        <div class="btn-group">
                                            <a href="{{ path('app_pontaj_update', {id: pontaj.id}) }}" class="btn btn-sm btn-light text-secondary"><i class="bi bi-pencil-square"></i></a>
                                            <a href="{{ path('app_pontaj_delete', {id: pontaj.id}) }}" class="btn btn-sm btn-light text-danger" onclick="return confirm('Sigur ștergi?')"><i class="bi bi-trash"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    {# --- VARIANTĂ MOBIL: Listă de Carduri (vizibilă doar sub md) --- #}
                    <div class="d-md-none">
                        {% for pontaj in pontaje %}
                            <div class="p-3 border-bottom">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light text-primary rounded-3 text-center p-2 me-3" style="min-width: 45px; border: 1px solid #eee;">
                                            <div class="fw-bold lh-1">{{ pontaj.timeStart|date('d') }}</div>
                                            <small style="font-size: 0.7rem;" class="text-uppercase">{{ pontaj.timeStart|date('M') }}</small>
                                        </div>
                                        <div>
                                            {% if pontaj.timeEnd %}
                                                {% set diffM = date(pontaj.timeEnd).diff(date(pontaj.timeStart)) %}
                                                <div class="fw-bold">{{ diffM|date('%h') }}h {{ diffM|date('%i') }}m</div>
                                                <small class="text-muted">{{ pontaj.timeStart|date('H:i') }} - {{ pontaj.timeEnd|date('H:i') }}</small>
                                            {% else %}
                                                <div class="fw-bold text-warning">În curs</div>
                                                <small class="text-muted">Start: {{ pontaj.timeStart|date('H:i') }}</small>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light border-0" type="button" data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                            <li><a class="dropdown-item" href="{{ path('app_pontaj_update', {id: pontaj.id}) }}"><i class="bi bi-pencil me-2"></i> Editează</a></li>
                                            <li><a class="dropdown-item text-danger" href="{{ path('app_pontaj_delete', {id: pontaj.id}) }}" onclick="return confirm('Ștergi?')"><i class="bi bi-trash me-2"></i> Șterge</a></li>
                                        </ul>
                                    </div>
                                </div>
                                {% if pontaj.details %}
                                    <div class="small text-muted bg-light p-2 rounded">{{ pontaj.details }}</div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center py-5">
                        <i class="bi bi-clipboard2-x display-4 text-muted opacity-50 mb-3"></i>
                        <h5 class="fw-bold text-muted">Nu există date</h5>
                        <p class="text-muted small">Începe prin a adăuga un pontaj nou.</p>
                    </div>
                {% endif %}
            </div>

            {# ================= CHART ================= #}
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-bar-chart-line me-2 text-primary"></i>Ore lucrate
                        </h5>
                        <div class="d-flex flex-wrap gap-2">
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-primary period-btn" data-period="week">7 zile</button>
                                <button type="button" class="btn btn-primary period-btn active" data-period="month">Lună</button>
                                <button type="button" class="btn btn-outline-primary period-btn" data-period="threeMonths">3 luni</button>
                                <button type="button" class="btn btn-outline-primary period-btn" data-period="sixMonths">6 luni</button>
                            </div>
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-primary type-btn active" data-type="bar" title="Bar">
                                    <i class="bi bi-bar-chart-fill"></i>
                                </button>
                                <button type="button" class="btn btn-outline-primary type-btn" data-type="line" title="Linie">
                                    <i class="bi bi-graph-up"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <canvas id="pontajChart" height="90"></canvas>
                </div>
            </div>

        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if app.user and active_company() %}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script>
        // ── Total Ore toggle ──
        function showStat(p) {
            document.getElementById('statWeek').classList.toggle('d-none', p !== 'week');
            document.getElementById('statMonth').classList.toggle('d-none', p !== 'month');
            document.getElementById('btnStatWeek').classList.toggle('btn-primary', p === 'week');
            document.getElementById('btnStatWeek').classList.toggle('btn-outline-primary', p !== 'week');
            document.getElementById('btnStatMonth').classList.toggle('btn-primary', p === 'month');
            document.getElementById('btnStatMonth').classList.toggle('btn-outline-primary', p !== 'month');
        }

        // ── QR Code ──
        (function () {
            const el = document.getElementById('qrCanvas');
            if (!el) return;
            const qrUrl = {{ openPontaj ? ('"' ~ url('app_pontaj_qr_end') ~ '"')|raw : ('"' ~ url('app_pontaj_qr_start') ~ '"')|raw }};
            new QRCode(el, {
                text: qrUrl,
                width: 110,
                height: 110,
                colorDark: '#000000',
                colorLight: '#ffffff',
                correctLevel: QRCode.CorrectLevel.M
            });
        })();
    </script>
    <script>
        const datasets    = {{ chartDatasets|raw }};
        let currentPeriod = 'month';
        let currentType   = 'bar';

        function makeDataset(type, labels, data) {
            const canvas = document.getElementById('pontajChart');
            const ctx    = canvas.getContext('2d');

            const gradient = ctx.createLinearGradient(0, 0, 0, 300);
            gradient.addColorStop(0, 'rgba(6, 71, 137, 0.85)');
            gradient.addColorStop(1, 'rgba(66, 122, 161, 0.15)');

            const base = {
                label: 'Ore lucrate',
                data: data,
                borderColor: 'rgba(6, 71, 137, 0.9)',
                borderWidth: 2,
            };

            if (type === 'bar') {
                return { ...base, backgroundColor: gradient, borderWidth: 0, borderRadius: 6, borderSkipped: false };
            } else {
                return { ...base, backgroundColor: gradient, fill: true, tension: 0.4, pointRadius: 4,
                         pointBackgroundColor: 'rgba(6,71,137,0.9)', pointBorderColor: '#fff', pointBorderWidth: 2 };
            }
        }

        const chartOptions = {
            responsive: true,
            animation: { duration: 300 },
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: { label: ctx => ` ${ctx.parsed.y}h lucrate` }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: { color: '#8a9bb0', font: { size: 11 } }
                },
                y: {
                    beginAtZero: true,
                    grid: { color: 'rgba(0,0,0,0.05)' },
                    ticks: { color: '#8a9bb0', font: { size: 11 }, callback: v => v + 'h' }
                }
            }
        };

        let chart = new Chart(document.getElementById('pontajChart'), {
            type: currentType,
            data: {
                labels: datasets[currentPeriod].labels,
                datasets: [makeDataset(currentType, datasets[currentPeriod].labels, datasets[currentPeriod].data)]
            },
            options: chartOptions
        });

        function rebuildChart() {
            chart.destroy();
            chart = new Chart(document.getElementById('pontajChart'), {
                type: currentType,
                data: {
                    labels: datasets[currentPeriod].labels,
                    datasets: [makeDataset(currentType, datasets[currentPeriod].labels, datasets[currentPeriod].data)]
                },
                options: chartOptions
            });
        }

        document.querySelectorAll('.period-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.period-btn').forEach(b => {
                    b.classList.remove('btn-primary', 'active');
                    b.classList.add('btn-outline-primary');
                });
                this.classList.remove('btn-outline-primary');
                this.classList.add('btn-primary', 'active');
                currentPeriod = this.dataset.period;
                rebuildChart();
            });
        });

        document.querySelectorAll('.type-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.type-btn').forEach(b => {
                    b.classList.remove('btn-primary', 'active');
                    b.classList.add('btn-outline-primary');
                });
                this.classList.remove('btn-outline-primary');
                this.classList.add('btn-primary', 'active');
                currentType = this.dataset.type;
                rebuildChart();
            });
        });
    </script>
    {% endif %}
{% endblock %}