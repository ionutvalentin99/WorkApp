{% extends 'base.html.twig' %}

{% block title %}WorkApp | Companie nouă{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <div class="rounded-3 bg-primary bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3"
                             style="width: 56px; height: 56px;">
                            <i class="bi bi-building-add text-primary fs-4"></i>
                        </div>
                        <h4 class="fw-bold mb-1">Creează o companie</h4>
                        <p class="text-muted small mb-0">Completează datele companiei. Vei fi redirecționat spre plată.</p>
                    </div>

                    {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}

                    <div class="mb-3">
                        {{ form_label(form.name) }}
                        {{ form_widget(form.name) }}
                        {{ form_errors(form.name) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.phone_number) }}
                        {{ form_widget(form.phone_number) }}
                        {{ form_errors(form.phone_number) }}
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            {{ form_label(form.country) }}
                            {{ form_widget(form.country) }}
                            {{ form_errors(form.country) }}
                        </div>
                        <div class="col-6">
                            {{ form_label(form.city) }}
                            {{ form_widget(form.city) }}
                            {{ form_errors(form.city) }}
                        </div>
                    </div>

                    <div class="mb-4">
                        {{ form_label(form.address) }}
                        {{ form_widget(form.address) }}
                        {{ form_errors(form.address) }}
                    </div>

                    <div class="d-flex align-items-center gap-2 text-muted small mb-4">
                        <i class="bi bi-lock-fill text-success"></i>
                        Plata se procesează securizat prin Stripe
                    </div>

                    {{ form_widget(form.Submit) }}

                    {{ form_end(form) }}

                    <div class="text-center mt-3">
                        <a href="{{ path('app_home') }}" class="text-muted small text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i>Înapoi acasă
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
